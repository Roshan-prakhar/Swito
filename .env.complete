# ========================================
# 🚀 Foodies API - Complete Environment Variables
# ========================================

# 🐘 NEON POSTGRESQL DATABASE
# ===========================
# Get these from: https://neon.tech
# 1. Sign up → Create project "foodies-db"
# 2. Create database "foodies"
# 3. Go to Connection Details → Copy values

DATABASE_URL=postgresql://your_neon_username:your_neon_password@ep-xxx-xxx.us-east-1.aws.neon.tech/foodies?sslmode=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

# ☁️ CLOUDFLARE R2 STORAGE
# =======================
# Get these from: https://cloudflare.com
# 1. Go to R2 Object Storage
# 2. Create bucket "foodies-images"
# 3. Go to R2 API tokens → Create token

CLOUDFLARE_ACCESS_KEY=your_r2_access_key_id_here
CLOUDFLARE_SECRET_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_BUCKET_NAME=foodies-images

# 🔐 JWT AUTHENTICATION
# ===================
# Already generated securely - no changes needed
JWT_SECRET=1361ae1fcc3a6babe6a9ed6d570fe7891753d678bfd2a07f9abc173f747d83654425838f4951f746a6288995eac275b3452aa336b99ae3f5749f4c43a50f0591

# ========================================
# 📋 SETUP INSTRUCTIONS
# ========================================

# STEP 1: NEON POSTGRESQL SETUP
# ============================
# 1. Go to https://neon.tech
# 2. Sign up with GitHub
# 3. Create new project: "foodies-db"
# 4. Create database: "foodies"
# 5. Go to Connection Details
# 6. Copy the connection string
# 7. Replace the values above:
#    - DATABASE_URL (full connection string)
#    - DB_USERNAME (extract from connection string)
#    - DB_PASSWORD (extract from connection string)

# STEP 2: CLOUDFLARE R2 SETUP
# =========================
# 1. Go to https://cloudflare.com
# 2. Navigate to R2 Object Storage
# 3. Create bucket: "foodies-images"
# 4. Go to "Manage R2 API tokens"
# 5. Create new API token
# 6. Set permissions: Object Read, Write, Delete
# 7. Copy Access Key ID and Secret Access Key
# 8. Replace the values above:
#    - CLOUDFLARE_ACCESS_KEY (Access Key ID)
#    - CLOUDFLARE_SECRET_KEY (Secret Access Key)
#    - CLOUDFLARE_R2_ENDPOINT (from S3 API section)
#    - CLOUDFLARE_BUCKET_NAME (bucket name)

# STEP 3: DEPLOY TO RENDER
# =======================
# 1. Go to https://render.com
# 2. Connect your GitHub repository
# 3. Render auto-detects render.yaml
# 4. Click "Create Web Service"
# 5. Wait for deployment to complete

# STEP 4: ADD ENVIRONMENT VARIABLES IN RENDER
# ==========================================
# 1. Go to your service → "Environment" tab
# 2. Add these 7 variables with your actual values:
#    - DATABASE_URL (from Neon)
#    - DB_USERNAME (from Neon)
#    - DB_PASSWORD (from Neon)
#    - CLOUDFLARE_ACCESS_KEY (from Cloudflare)
#    - CLOUDFLARE_SECRET_KEY (from Cloudflare)
#    - CLOUDFLARE_R2_ENDPOINT (from Cloudflare)
#    - CLOUDFLARE_BUCKET_NAME (from Cloudflare)
# 3. JWT_SECRET is already configured in render.yaml

# STEP 5: RESTART SERVICE
# =======================
# 1. Click "Manual Deploy" → "Deploy Latest Commit"
# 2. Wait for restart
# 3. Check logs for successful connections

# ========================================
# 🎯 EXAMPLE VALUES (Replace with your actual values)
# ========================================

# NEON POSTGRESQL EXAMPLE:
# DATABASE_URL=postgresql://foodies_user:abc123def@ep-cool-darkness-123456.us-east-1.aws.neon.tech/foodies?sslmode=require
# DB_USERNAME=foodies_user
# DB_PASSWORD=abc123def

# CLOUDFLARE R2 EXAMPLE:
# CLOUDFLARE_ACCESS_KEY=0123456789ABCDEF0123456789ABCDEF
# CLOUDFLARE_SECRET_KEY=abcdef1234567890abcdef1234567890abcdef1234567890
# CLOUDFLARE_R2_ENDPOINT=https://a1b2c3d4e5f6g7h8.r2.cloudflarestorage.com
# CLOUDFLARE_BUCKET_NAME=foodies-images

# ========================================
# ✅ VERIFICATION CHECKLIST
# ========================================

# AFTER SETUP, VERIFY:
# [ ] Neon database is accessible
# [ ] Cloudflare bucket exists and is accessible
# [ ] All environment variables are set in Render
# [ ] API starts successfully
# [ ] Health check passes: GET /actuator/health
# [ ] Database connection works
# [ ] Image upload works
# [ ] Dummy payment works

# ========================================
# 🔧 TROUBLESHOOTING
# ========================================

# IF DATABASE CONNECTION FAILS:
# - Check DATABASE_URL format
# - Verify DB_USERNAME and DB_PASSWORD
# - Ensure SSL mode is set to 'require'
# - Check if Neon database exists

# IF IMAGE UPLOAD FAILS:
# - Check Cloudflare credentials
# - Verify bucket name matches exactly
# - Check endpoint URL format
# - Ensure bucket permissions allow access

# IF BUILD FAILS:
# - Check render.yaml syntax
# - Verify all required variables are set
# - Check for typos in variable names
# - Review Render build logs

# ========================================
# 🚀 YOUR API URL AFTER DEPLOYMENT
# ========================================

# https://foodies-api.onrender.com/api

# KEY ENDPOINTS:
# GET  /actuator/health                    # Health check
# POST /api/auth/register                  # User registration
# POST /api/auth/login                     # User login
# GET  /api/foods                          # Get all foods
# POST /api/foods                          # Add food (admin)
# POST /api/orders/create                  # Create order
# GET  /api/orders                         # User orders
# GET  /api/orders/all                     # All orders (admin)
# POST /api/payments/process               # Dummy payment
# GET  /api/payments/methods               # Payment methods
