# ========================================
# Foodies API Environment Variables (Simplified)
# ========================================

# Database Configuration (Auto-set by Render)
# DATABASE_URL=jdbc:postgresql://host:5432/database
# DB_USERNAME=foodies_user
# DB_PASSWORD=your_database_password

# JWT Secret for Authentication
JWT_SECRET=1361ae1fcc3a6babe6a9ed6d570fe7891753d678bfd2a07f9abc173f747d83654425838f4951f746a6288995eac275b3452aa336b99ae3f5749f4c43a50f0591

# Cloudflare R2 Configuration
CLOUDFLARE_ACCESS_KEY=your_r2_access_key_id_here
CLOUDFLARE_SECRET_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_BUCKET_NAME=foodies-images

# ========================================
# Instructions for Deployment
# ========================================

# 1. Replace the Cloudflare placeholder values with your actual credentials
# 2. In Render dashboard, add these as environment variables:
#    - JWT_SECRET (already configured in render.yaml)
#    - CLOUDFLARE_ACCESS_KEY
#    - CLOUDFLARE_SECRET_KEY
#    - CLOUDFLARE_R2_ENDPOINT
#    - CLOUDFLARE_BUCKET_NAME
# 3. Database variables are auto-configured by Render

# ========================================
# What's Removed
# ========================================
# ❌ Razorpay payment integration removed
# ❌ No payment processing required
# ❌ Simpler deployment process
# ❌ Fewer environment variables to manage

# ========================================
# Security Notes
# ========================================

# - Never commit this file to Git with real credentials
# - Use different keys for different services
# - JWT_SECRET is already generated securely
# - Keep your Cloudflare keys private

# ========================================
# Alternative Payment Options (Future)
# ========================================

# If you want to add payments later, consider:
# - Stripe (simpler API)
# - PayPal (widely used)
# - Cash on Delivery (simplest)
# - Or keep it payment-free for demo purposes
