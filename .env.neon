# ========================================
# Foodies API Environment Variables - Neon PostgreSQL
# ========================================

# Neon PostgreSQL Configuration
# Get these from your Neon dashboard: https://neon.tech
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.us-east-1.aws.neon.tech/foodies?sslmode=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

# JWT Secret for Authentication
JWT_SECRET=1361ae1fcc3a6babe6a9ed6d570fe7891753d678bfd2a07f9abc173f747d83654425838f4951f746a6288995eac275b3452aa336b99ae3f5749f4c43a50f0591

# Cloudflare R2 Configuration
CLOUDFLARE_ACCESS_KEY=your_r2_access_key_id_here
CLOUDFLARE_SECRET_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_BUCKET_NAME=foodies-images

# ========================================
# Neon PostgreSQL Setup Instructions
# ========================================

# 1. Go to https://neon.tech
# 2. Sign up for free account
# 3. Create new project: "foodies-db"
# 4. Create database: "foodies"
# 5. Get connection string from Dashboard
# 6. Copy these values:
#    - Connection String (DATABASE_URL)
#    - Username (DB_USERNAME)
#    - Password (DB_PASSWORD)

# ========================================
# Neon Connection String Format
# ========================================

# Your DATABASE_URL should look like:
# postgresql://username:password@ep-xxx-xxx.us-east-1.aws.neon.tech/foodies?sslmode=require

# Example:
# DATABASE_URL=postgresql://foodies_user:abc123@ep-cool-darkness-123456.us-east-1.aws.neon.tech/foodies?sslmode=require
# DB_USERNAME=foodies_user
# DB_PASSWORD=abc123

# ========================================
# Render Environment Variables
# ========================================

# Add these in Render dashboard after deployment:
# - DATABASE_URL (from Neon)
# - DB_USERNAME (from Neon)
# - DB_PASSWORD (from Neon)
# - CLOUDFLARE_ACCESS_KEY (your R2 key)
# - CLOUDFLARE_SECRET_KEY (your R2 secret)
# - CLOUDFLARE_R2_ENDPOINT (your R2 endpoint)
# - CLOUDFLARE_BUCKET_NAME (your bucket name)
# - JWT_SECRET is already configured

# ========================================
# Why Neon PostgreSQL?
# ========================================

# ✅ Free tier: 3GB storage, 1GB RAM
# ✅ Serverless: Auto-scaling, no server management
# ✅ Always-on: No cold starts
# ✅ Global CDN: Fast connections worldwide
# ✅ Branching: Like Git for databases
# ✅ SSL connections: Secure by default
# ✅ Easy setup: No server configuration needed
